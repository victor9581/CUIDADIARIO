<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2DD4BF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#0F766E" />
                    <stroke android:width="1dp" android:color="#115E59" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#0D9488"
                        android:endColor="#0F766E" />
                    <stroke android:width="1dp" android:color="#5EEAD4" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>