<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#34D399">
    <item>
        <selector>
            <!-- Estado: Al presionarlo (se hunde y oscurece) -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#047857" />
                    <stroke android:width="1dp" android:color="#065F46" />
                </shape>
            </item>
            <!-- Estado Normal: Degradado con volumen -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#10B981"
                        android:endColor="#059669" />
                    <stroke android:width="1dp" android:color="#34D399" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>