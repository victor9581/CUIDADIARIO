<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_overlay"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABECERA ILUSTRADA: Presentando a la Enfermera Sofía -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Nueva Imagen Oficial en lugar de emoji -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_nurse"
                android:scaleType="centerCrop"
                android:background="#E0F2FE" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asistente Sofía"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vamos a configurar un nuevo tratamiento."
                    android:textSize="12sp"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN 1: ¿Es Mascota o Persona? -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <CheckBox
                android:id="@+id/cbIsPet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🐾 Administrar medicamento a mascota"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Campo Mascota -->
            <EditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nombre de tu mascota (Ej. Toby, Luna)"
                android:background="#F1F5F9"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- SECCIÓN 2: Fotografía del Medicamento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fotografía del Fármaco"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="150dp"
                android:layout_height="140dp"
                android:background="#E2E8F0"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera"
                android:layout_marginBottom="12dp"
                android:elevation="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="📷 Cámara"
                    android:background="@drawable/btn_primary_raised"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:elevation="3dp" />

                <Button
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🖼️ Galería"
                    android:backgroundTint="#475569"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:elevation="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN 3: Datos Clínicos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del fármaco"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etMedName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. Amoxicilina, Nexgard, Insulina"
                android:background="#F1F5F9"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosis"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDose"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. 1 tableta, 5ml, 2 gotas"
                android:background="#F1F5F9"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frecuencia (Cada cuántas horas)"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etIntervalHours"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. 8 (para cada 8 horas)"
                android:inputType="number"
                android:background="#F1F5F9"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora de la primera toma:"
                android:textStyle="bold"
                android:textColor="#0284C7"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPickStartTime"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="⏰ Me tomaré la dosis a las: [ 08:00 ]"
                android:backgroundTint="#E0F2FE"
                android:textColor="#0369A1"
                android:textStyle="bold"
                android:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSelectStartDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="📅 Fecha de Inicio: Hoy"
                android:backgroundTint="#F1F5F9"
                android:textColor="#334155"
                android:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/cbIsLifetime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♾️ Medicamento de por vida (Continuo)"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Duración -->
            <LinearLayout
                android:id="@+id/llDaysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duración total del tratamiento (Días)"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTotalDays"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej. 7, 14, 30"
                    android:inputType="number"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnSaveMedication"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✓ Programar Tratamiento y Alarmas"
            android:background="@drawable/btn_emerald_raised"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:elevation="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Cancelar"
            android:backgroundTint="#94A3B8"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>