<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_rounded_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔗 Vinculación con Monitor Web"
        android:textColor="#0284C7"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSyncUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tutor: Victor Aguilar"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu Código Familiar Único:"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvSyncFamilyCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CD-1001"
        android:textColor="#0D9488"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:background="#CCFBF1"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="6dp" />

    <!-- Imagen del código QR -->
    <ImageView
        android:id="@+id/ivSyncQrCode"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="#F8FAFC"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escanea este QR con tu computadora para abrir el panel familiar automáticamente."
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnSyncLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cerrar Sesión en este Celular"
        android:backgroundTint="#FEE2E2"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSyncClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cerrar"
        android:backgroundTint="#E2E8F0"
        android:textColor="#334155"
        android:textSize="13sp" />

</LinearLayout>