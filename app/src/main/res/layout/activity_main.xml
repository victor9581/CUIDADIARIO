<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app_overlay">

    <!-- Contenido Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <!-- TARJETA ENFERMERA CON RELIEVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_bg"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/tvNurseAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_nurse"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="#E0F2FE"
                    android:padding="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enfermera CuidaDiario"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNurseMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enfermera Sofía: Hola, recuerda tomar tus dosis a tiempo para mantener tu bienestar."
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta de Tutor y Vinculación Web -->
            <LinearLayout
                android:id="@+id/cardTutorSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0FDF4"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗"
                    android:textSize="24sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMainTutorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tutor: Conectado"
                        android:textColor="#166534"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMainFamilyCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Código Web: CD-1001 • Toca para ver QR"
                        android:textColor="#15803D"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenSyncDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="VER QR"
                    android:textSize="11sp"
                    android:backgroundTint="#16A34A"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Botón Checklist con Relieve Turquesa -->
            <Button
                android:id="@+id/btnGoToTasks"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📝 VER CHECKLIST / AGENDA DIARIA"
                android:background="@drawable/btn_teal_raised"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:elevation="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Botón Registrar Medicamento con Relieve Azul -->
            <Button
                android:id="@+id/btnOpenAddMed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="+ REGISTRAR NUEVO MEDICAMENTO"
                android:background="@drawable/btn_primary_raised"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus Tratamientos en Curso"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Contenedor Dinámico de Tarjetas -->
            <LinearLayout
                android:id="@+id/llMedicationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Menú Lateral Desplegable con Cabecera Ilustrada -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>