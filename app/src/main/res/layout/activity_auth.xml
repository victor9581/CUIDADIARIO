<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_overlay"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo / Enfermera Sofía -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_nurse"
            android:scaleType="centerCrop"
            android:background="#CCFBF1"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CuidaDiario"
            android:textColor="#0284C7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistente Sofía: Cuidado Gerontológico y Veterinario"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"
            android:textAlignment="center" />

        <!-- Tarjeta Flotante Accesible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Pestañas Iniciar Sesión / Registrarme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btnTabLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Iniciar Sesión"
                    android:backgroundTint="#0D9488"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnTabRegister"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Crear Cuenta"
                    android:backgroundTint="#E2E8F0"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Campo Nombre Completo (Solo visible en Registro) -->
            <TextView
                android:id="@+id/lblAuthName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu Nombre Completo (Tutor):"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etAuthName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Ej. Ing. Carlos Morales"
                android:background="#F1F5F9"
                android:paddingHorizontal="14dp"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- Campo Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo Electrónico:"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="ejemplo@correo.com"
                android:background="#F1F5F9"
                android:paddingHorizontal="14dp"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="14dp" />

            <!-- Campo Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña:"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="••••••••"
                android:background="#F1F5F9"
                android:paddingHorizontal="14dp"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:layout_marginBottom="22dp" />

            <!-- Botón Principal -->
            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ENTRAR A CUIDADIARIO"
                android:background="@drawable/btn_teal_raised"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Indicador modo invitado rápido de evaluación -->
            <TextView
                android:id="@+id/tvDemoMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 ¿Modo prueba rápida? Toca aquí para auto-rellenar"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvTermsPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver Términos y Privacidad"
                android:textColor="#0288D1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:padding="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tus datos se sincronizan con auditoría satelital GPS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>