<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardMedicationItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_rounded_bg"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="16dp">

    <!-- Cabecera de la Tarjeta: Badge + Botones Rápidos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvCardBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 Tratamiento Personal"
            android:textColor="#0284C7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnQuickEdit"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:text="✏️"
            android:textSize="13sp"
            android:backgroundTint="#F1F5F9"
            android:textColor="#0F172A"
            android:elevation="2dp"
            android:padding="0dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnQuickDelete"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:text="🗑️"
            android:textSize="13sp"
            android:backgroundTint="#FEE2E2"
            android:textColor="#DC2626"
            android:elevation="2dp"
            android:padding="0dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="↔️ Desliza tarjeta: Derecha ➡ Editar | Izquierda ⬅ Borrar"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/imgCardPhoto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="#E2E8F0"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:elevation="2dp"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Medicamento"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardDose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosis: 1 tableta"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvCardInterval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ Cada 8 hrs (Inicio: 08:00)"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barra de Progreso Verde Esmeralda -->
    <ProgressBar
        android:id="@+id/pbCardProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginVertical="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#10B981" />

    <TextView
        android:id="@+id/tvCardDaysStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Llevas 0 días • Te faltan 0 días para terminar"
        android:textColor="#047857"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Sección Ubicación -->
    <LinearLayout
        android:id="@+id/llLocationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:padding="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvCardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Última toma: Pendiente de registro"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnCardOpenMap"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="📍 Ver ubicación en Google Maps"
            android:background="@drawable/btn_primary_raised"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:elevation="3dp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Botón con Relieve: Administrado -->
    <Button
        android:id="@+id/btnCardTakeDose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="✓ Ya Administrado"
        android:background="@drawable/btn_emerald_raised"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:elevation="5dp" />

</LinearLayout>