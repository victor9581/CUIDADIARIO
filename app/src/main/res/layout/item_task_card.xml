<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardTaskItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_rounded_bg"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="14dp">

    <!-- Fila Superior: Checkbox + Nombre + Botón Eliminar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbTaskStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#0D9488" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvTaskName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la tarea"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTaskDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Hoy • ⏰ 10:00 AM"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDeleteTask"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:text="🗑️"
            android:textSize="13sp"
            android:backgroundTint="#FEE2E2"
            android:textColor="#DC2626"
            android:elevation="1dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Contenedor GPS (Aparece cuando la tarea está completada y tiene ubicación) -->
    <LinearLayout
        android:id="@+id/llTaskGpsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0FDFA"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTaskLocationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Completado con verificación GPS"
            android:textColor="#0F766E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnTaskOpenMap"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="📍 Ver punto de cumplimiento en Maps"
            android:background="@drawable/btn_teal_raised"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>