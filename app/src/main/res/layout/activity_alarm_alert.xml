<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1929"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Encabezado con insignia clínica -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvAlarmCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E3A8A"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="ALERTA MÉDICA PRIORITARIA"
            android:textColor="#BFDBFE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvAlarmMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¡HORA DE TU MEDICAMENTO!"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Espacio central para fotografía/ilustración y nombres grandes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E293B">

            <ImageView
                android:id="@+id/ivAlarmIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvAlarmItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Fármaco"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvAlarmItemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Dosis prescrita: 500mg"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Zona de Botones Grandes Accesibles para Adultos Mayores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <!-- Botón Principal: Confirmar Acción -->
        <Button
            android:id="@+id/btnConfirmarAccion"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:backgroundTint="#16A34A"
            android:text="✓ YA ME LO TOMÉ"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Botón Secundario: Posponer 10 minutos -->
        <Button
            android:id="@+id/btnPosponerAccion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#334155"
            android:text="⏰ RECORDAR EN 10 MINUTOS"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>