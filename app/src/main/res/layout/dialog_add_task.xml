<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_rounded_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Cabecera con Sofía Grande -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nurse"
                android:scaleType="centerCrop"
                android:background="#CCFBF1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva Tarea o Actividad"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asistente Sofía: Planifica tu recordatorio."
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Etiqueta 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué actividad necesitas recordar?"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <!-- Campo de Texto Amplio -->
        <EditText
            android:id="@+id/etDialogTaskName"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="Ej. Comprar medicamentos, Cita con doctor, Paseo"
            android:background="#F1F5F9"
            android:paddingHorizontal="16dp"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Botón Grande de Fecha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha programada:"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnDialogTaskDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📅 Fecha: Hoy (Toca para cambiar)"
            android:backgroundTint="#F1F5F9"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="1dp"
            android:layout_marginBottom="14dp" />

        <!-- Botón Grande de Hora -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora de la alerta:"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnDialogTaskTime"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="⏰ Hora: 09:00 AM (Toca para cambiar)"
            android:backgroundTint="#CCFBF1"
            android:textColor="#0F766E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="1dp"
            android:layout_marginBottom="22dp" />

        <!-- Botón Guardar Tarea (Accesible y con Relieve) -->
        <Button
            android:id="@+id/btnDialogSaveTask"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✓ Guardar Tarea en mi Agenda"
            android:background="@drawable/btn_teal_raised"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:layout_marginBottom="10dp" />

        <!-- Botón Cancelar -->
        <Button
            android:id="@+id/btnDialogCancelTask"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancelar"
            android:backgroundTint="#94A3B8"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:elevation="1dp" />

    </LinearLayout>
</ScrollView>